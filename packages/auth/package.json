{
  "name": "@scoresquid/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Shared sign-in code for ScoreSquid apps: Supabase clients, proxy, callback, login and account UI. Each app keeps its own Supabase project.",
  "exports": {
    "./actions": "./src/actions.ts",
    "./callback": "./src/callback.ts",
    "./client": "./src/client.ts",
    "./login-errors": "./src/login-errors.ts",
    "./profile": "./src/profile.ts",
    "./proxy": "./src/proxy.ts",
    "./redirect": "./src/redirect.ts",
    "./server": "./src/server.ts",
    "./settings": "./src/settings.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scoresquid/ui": "*",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.76.1",
    "lucide-react": "^0.511.0",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.7"
  },
  "peerDependencies": {
    "next": "^16.0.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@scoresquid/config": "*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "typescript": "^5",
    "@vitest/coverage-v8": "^4.1.1",
    "vitest": "^4.1.1"
  }
}
