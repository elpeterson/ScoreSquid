# Copy to .env.local and fill in from Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Base URL used in auth email links (sign-up, password reset).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Production only: `.scoresquid.com`, so one sign-in works on every sport.
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Server only: the limited be_crawler role through Supabase's shared pooler, port 6543.
# Add sslmode=disable only for a local database.
# BE_CRAWLER_DATABASE_URL=
